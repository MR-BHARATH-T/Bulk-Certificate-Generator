# Database - Defaulting to SQLite for easiest local testing
# To use PostgreSQL, change to: postgresql://username:password@localhost:5432/cert_db
DATABASE_URL=sqlite:///./cert_db.db

# Storage
# Where PDFs will be saved locally
LOCAL_STORAGE_DIR=storage/certificates

# App
MAX_BATCH_SIZE=1000000
WORKER_CONCURRENCY=5

