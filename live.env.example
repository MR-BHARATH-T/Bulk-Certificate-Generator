# ==========================================
# BACKEND & DATABASE LIVE PROPERTIES
# ==========================================

# 1. LIVE DATABASE (Supabase PostgreSQL)
# When deploying live, use the Transaction Pooler Connection String from Supabase
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. LIVE STORAGE (Supabase Storage)
# If you decide to switch back to Supabase for storing PDFs in the cloud:
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
STORAGE_BUCKET=certificates

# 3. BACKEND API SETTINGS (Render / Live)
MAX_BATCH_SIZE=1000000
WORKER_CONCURRENCY=5


# ==========================================
# FRONTEND LIVE PROPERTIES
# ==========================================

# 1. LIVE API URL (Vercel)
# The URL where your backend is hosted (e.g., Render)
VITE_API_URL=https://your-backend-api-name.onrender.com/api/v1
